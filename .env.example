# Copy this file to .env and fill in real values when you have them.
# Until RAZORPAY_KEY_ID / RAZORPAY_KEY_SECRET are set, the app runs in
# MOCK MODE automatically -- it simulates Razorpay Test Mode responses
# (including one simulated failure) so you can build and demo without
# a real Razorpay account.

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_BASE_URL=https://api.razorpay.com/v1

# Optional: only needed if you enable the LLM-powered "Ask ReconPilot" tab.
# Without this key, the agent falls back to a rule-based canned-answer mode
# so the rest of the app still works.
LLM_API_KEY=
LLM_MODEL=claude-sonnet-4-6


API_TIMEOUT_SECONDS=20
MAX_API_ATTEMPTS=3
AMOUNT_TOLERANCE_PAISE=0
PROBABLE_MATCH_THRESHOLD_DAYS=3
SETTLEMENT_SLA_DAYS=5
